{
  "name": "lumera-creative-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/seed-demo.ts",
    "backup": "./scripts/backup.sh",
    "test:e2e": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tests/e2e.ts",
    "test:edge": "node --disable-warning=ExperimentalWarning tests/edge-paths.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.1",
    "@iconify/react": "^6.0.2",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "hono": "^4.13.9",
    "lenis": "^1.3.26",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.12",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
