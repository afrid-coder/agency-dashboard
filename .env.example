# ─── Lumera Creative workspace — configuration ───────────────────────────
# Copy to .env for local overrides. Never commit .env or real secrets.
# Everything here is read by the server only; nothing reaches the browser.

# Public URL people open (used for email links and origin checks).
# Development default: http://localhost:5173   Production: https://workspace.example.com
APP_URL=http://localhost:5173
PORT=8787
# Set to 1 behind a reverse proxy / load balancer that sets X-Forwarded-For.
# TRUST_PROXY=1

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Required in production. Without it, development uses an embedded
# PostgreSQL (PGlite) stored in data/pg.
# DATABASE_URL=postgres://user:password@host:5432/lumera
# require | no-verify | disable   (default: require for non-local hosts)
# DATABASE_SSL=require
# DATABASE_POOL_SIZE=10

# ─── Authentication ─────────────────────────────────────────────────────
# Signs sessions and peppers quick-unlock PINs. Required in production;
# at least 32 characters:  openssl rand -base64 48
# Development generates one in data/secret.key.
# BETTER_AUTH_SECRET=

# Four-digit code the business owners use to sign up as admins (switch on
# "Admin" on the sign-up page). The first person to use it creates the
# Lumera Creative workspace and becomes its owner. Built-in default: 7391.
# Set your own before going live, and change it if it's ever shared.
# ADMIN_SIGNUP_CODE=7391

# ─── Email (password reset, invitations) ────────────────────────────────
# Configure ONE provider. Without one, development captures emails in the
# local inbox at /dev/outbox, and production can't send reset or invitation
# emails (the server warns at startup).
# MAIL_FROM="Lumera Creative <workspace@your-domain.com>"
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# ─── Lume (Anthropic) ───────────────────────────────────────────────────
# Server-side only. Without a key, development runs Lume in a clearly
# labelled demo mode; production shows a "not connected" setup state.
# ANTHROPIC_API_KEY=
# LUME_MODEL=claude-opus-5
# LUME_EFFORT=medium                   # low | medium | high | xhigh | max
# LUME_MAX_OUTPUT_TOKENS=4096
# LUME_TIMEOUT_MS=90000
# LUME_REQUESTS_PER_MINUTE=8           # per person
# LUME_DAILY_REQUESTS_PER_USER=150     # chat + briefings, per person per day
# LUME_MONTHLY_TOKEN_BUDGET=5000000    # input + output tokens, per workspace per month
# LUME_DEMO_MODE=auto                  # auto | off (development only; "on" is refused in production)

# ─── Development only ───────────────────────────────────────────────────
# DATA_DIR=./data
# DEMO_PASSWORD=studio-demo-2026       # password for the seeded demo accounts
